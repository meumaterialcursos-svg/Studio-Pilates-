rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Cada usuária só acessa a própria pasta: users/{uid}/sync/*
    match /users/{uid}/sync/{docId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().size() <= 10
        && (docId == 'meta' ? request.resource.data.rev is int
                            : request.resource.data.d is string);
    }

    // Todo o resto é negado.
    match /{document=**} { allow read, write: if false; }
  }
}
